{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "harmonyos",
      "displayName": "HarmonyOS arm64 runtime",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/harmonyos",
      "toolchainFile": "$env{OHOS_SDK_NATIVE}/build/cmake/ohos.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "OHOS_ARCH": "arm64-v8a",
        "OHOS_STL": "c++_shared",
        "SKY_BUILD_SANDBOX": "OFF",
        "SKY_BUILD_TOOL": "OFF",
        "SKY_BUILD_TEST": "OFF",
        "SKY_BUILD_NETWORK_ENET": "OFF",
        "SKY_BUILD_AUDIO": "OFF"
      }
    },
    {
      "name": "windows-develop",
      "displayName": "Windows Develop editor",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/cmake-build-debug",
      "cacheVariables": {
        "SKY_BUILD_SANDBOX": "ON",
        "SKY_BUILD_TEST": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "linux-develop",
      "displayName": "Linux Develop editor",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-develop",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Develop",
        "SKY_BUILD_SANDBOX": "ON",
        "SKY_BUILD_TEST": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "macos-develop",
      "displayName": "macOS Develop editor",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/cmake-build-develop",
      "cacheVariables": { "SKY_BUILD_SANDBOX": "ON", "SKY_BUILD_TEST": "ON" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    }
  ],
  "buildPresets": [
    { "name": "harmonyos", "configurePreset": "harmonyos" },
    { "name": "windows-develop", "configurePreset": "windows-develop", "configuration": "Develop" },
    { "name": "windows-debug", "configurePreset": "windows-develop", "configuration": "Debug" },
    { "name": "windows-release", "configurePreset": "windows-develop", "configuration": "Release" },
    { "name": "linux-develop", "configurePreset": "linux-develop" },
    { "name": "macos-develop", "configurePreset": "macos-develop", "configuration": "Develop" }
  ]
}
