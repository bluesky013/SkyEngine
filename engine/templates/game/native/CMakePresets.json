{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/../build/${presetName}",
      "cacheVariables": {
        "SKY_ENGINE_ROOT": "$env{SKY_ENGINE_ROOT}",
        "SKY_BUILD_TEST": "OFF",
        "SKY_BUILD_TOOL": "OFF"
      }
    },
    {
      "name": "macos",
      "inherits": "base",
      "generator": "Xcode",
      "cacheVariables": { "SKY_PLATFORM": "macos", "CMAKE_BUILD_TYPE": "Release" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "windows",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "cacheVariables": { "SKY_PLATFORM": "windows" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "linux",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": { "SKY_PLATFORM": "linux", "CMAKE_BUILD_TYPE": "Release" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "android",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "SKY_PLATFORM": "android",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-31",
        "ANDROID_STL": "c++_static"
      }
    },
    {
      "name": "ios",
      "inherits": "base",
      "generator": "Xcode",
      "cacheVariables": {
        "SKY_PLATFORM": "ios",
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "ios-simulator",
      "inherits": "ios",
      "description": "Set SKY_IOS_SIMULATOR_ARCH and SKY_3RD_PATH to matching simulator dependencies.",
      "cacheVariables": {
        "SKY_PLATFORM": "ios-simulator",
        "CMAKE_OSX_SYSROOT": "iphonesimulator",
        "CMAKE_OSX_ARCHITECTURES": "$env{SKY_IOS_SIMULATOR_ARCH}",
        "3RD_PATH": "$env{SKY_3RD_PATH}"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    { "name": "windows-develop", "inherits": "windows", "cacheVariables": { "CMAKE_BUILD_TYPE": "Develop", "SKY_DEVELOP": "ON" } },
    { "name": "linux-develop", "inherits": "linux", "cacheVariables": { "CMAKE_BUILD_TYPE": "Develop", "SKY_DEVELOP": "ON" } },
    { "name": "macos-develop", "inherits": "macos", "cacheVariables": { "CMAKE_BUILD_TYPE": "Develop", "SKY_DEVELOP": "ON" } },
    { "name": "ios-develop", "inherits": "ios", "cacheVariables": { "CMAKE_BUILD_TYPE": "Develop", "SKY_DEVELOP": "ON" } },
    { "name": "android-develop", "inherits": "android", "cacheVariables": { "CMAKE_BUILD_TYPE": "Develop", "SKY_DEVELOP": "ON" } }
  ],
  "buildPresets": [
    { "name": "macos", "configurePreset": "macos", "configuration": "Release" },
    { "name": "windows", "configurePreset": "windows", "configuration": "Release" },
    { "name": "linux", "configurePreset": "linux" },
    { "name": "android", "configurePreset": "android" },
    { "name": "ios", "configurePreset": "ios", "configuration": "Release" },
    { "name": "ios-simulator", "configurePreset": "ios-simulator", "configuration": "Release" },
    { "name": "windows-develop", "configurePreset": "windows-develop", "configuration": "Develop" },
    { "name": "linux-develop", "configurePreset": "linux-develop", "configuration": "Develop" },
    { "name": "macos-develop", "configurePreset": "macos-develop", "configuration": "Develop" },
    { "name": "ios-develop", "configurePreset": "ios-develop", "configuration": "Develop" },
    { "name": "android-develop", "configurePreset": "android-develop", "configuration": "Develop" }
  ]
}
