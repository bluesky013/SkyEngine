#version 450
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, rgba8) uniform readonly image2D sourceImage;
layout(set = 0, binding = 1, std430) buffer Output { uint values[]; } outputData;
layout(set = 0, binding = 2, std430) readonly buffer Input { uint values[]; } inputData;
void main() {
    outputData.values[gl_GlobalInvocationID.x] = inputData.values[gl_GlobalInvocationID.x] + uint(imageLoad(sourceImage, ivec2(0)).g * 255.0);
}
