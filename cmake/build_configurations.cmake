include_guard(GLOBAL)

get_property(_sky_multi_config GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
if (_sky_multi_config)
    set(_sky_configurations ${CMAKE_CONFIGURATION_TYPES})
    list(APPEND _sky_configurations Develop)
    list(REMOVE_DUPLICATES _sky_configurations)
    set(CMAKE_CONFIGURATION_TYPES "${_sky_configurations}" CACHE STRING "Available build configurations" FORCE)
else ()
    set_property(CACHE CMAKE_BUILD_TYPE PROPERTY STRINGS Debug Develop Release RelWithDebInfo MinSizeRel)
endif ()

foreach (_sky_language C CXX OBJC OBJCXX)
    if (MSVC)
        set(_sky_develop_flags "/O2 /Ob2 /Zi /DNDEBUG")
    elseif (DEFINED CMAKE_${_sky_language}_FLAGS_RELWITHDEBINFO)
        set(_sky_develop_flags "${CMAKE_${_sky_language}_FLAGS_RELWITHDEBINFO}")
    else ()
        set(_sky_develop_flags "${CMAKE_CXX_FLAGS_RELWITHDEBINFO}")
    endif ()
    # Enabling a language can seed an empty cache entry for a custom configuration.
    if (NOT DEFINED CMAKE_${_sky_language}_FLAGS_DEVELOP OR "${CMAKE_${_sky_language}_FLAGS_DEVELOP}" STREQUAL "")
        set(CMAKE_${_sky_language}_FLAGS_DEVELOP "${_sky_develop_flags}" CACHE STRING "Develop ${_sky_language} compiler flags" FORCE)
    endif ()
    mark_as_advanced(CMAKE_${_sky_language}_FLAGS_DEVELOP)
endforeach ()
foreach (_sky_linker EXE SHARED MODULE STATIC)
    set(CMAKE_${_sky_linker}_LINKER_FLAGS_DEVELOP "${CMAKE_${_sky_linker}_LINKER_FLAGS_RELWITHDEBINFO}"
        CACHE STRING "Develop ${_sky_linker} linker flags")
    mark_as_advanced(CMAKE_${_sky_linker}_LINKER_FLAGS_DEVELOP)
endforeach ()

if (MSVC AND NOT DEFINED CMAKE_MSVC_RUNTIME_LIBRARY)
    set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
endif ()
if (NOT DEFINED CMAKE_MAP_IMPORTED_CONFIG_DEVELOP)
    set(CMAKE_MAP_IMPORTED_CONFIG_DEVELOP Develop RelWithDebInfo Release)
endif ()

function(sky_configure_diagnostic option definition automatic)
    set(${option} AUTO CACHE STRING "${definition} policy: AUTO, ON or OFF")
    set_property(CACHE ${option} PROPERTY STRINGS AUTO ON OFF)
    string(TOUPPER "${${option}}" _policy)
    if (_policy STREQUAL "AUTO")
        set(_value "${automatic}")
    elseif (_policy STREQUAL "ON")
        set(_value 1)
    elseif (_policy STREQUAL "OFF")
        set(_value 0)
    else ()
        message(FATAL_ERROR "${option} must be AUTO, ON or OFF (got '${${option}}')")
    endif ()
    add_compile_definitions("${definition}=${_value}")
endfunction()

add_compile_definitions("SKY_BUILD_DEVELOP=$<CONFIG:Develop>")
sky_configure_diagnostic(SKY_ASSERTIONS SKY_ENABLE_ASSERT "$<OR:$<CONFIG:Debug>,$<CONFIG:Develop>>")
sky_configure_diagnostic(SKY_GPU_VALIDATION SKY_ENABLE_GPU_VALIDATION "$<CONFIG:Debug>")
sky_configure_diagnostic(SKY_RESOURCE_NAMES SKY_ENABLE_RESOURCE_NAME "$<BOOL:${SKY_DEVELOP}>")
