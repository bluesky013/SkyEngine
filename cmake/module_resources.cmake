include_guard(GLOBAL)

function(sky_runtime_resource_directory result)
    if(CMAKE_RUNTIME_OUTPUT_DIRECTORY)
        set(directory "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}")
        get_property(multi_config GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
        if(multi_config)
            string(APPEND directory "/$<CONFIG>")
            foreach(configuration IN LISTS CMAKE_CONFIGURATION_TYPES)
                string(TOUPPER "${configuration}" configuration_upper)
                set(configuration_directory "${CMAKE_RUNTIME_OUTPUT_DIRECTORY_${configuration_upper}}")
                if(configuration_directory)
                    set(directory "$<IF:$<CONFIG:${configuration}>,${configuration_directory},${directory}>")
                endif()
            endforeach()
        elseif(CMAKE_BUILD_TYPE)
            string(TOUPPER "${CMAKE_BUILD_TYPE}" configuration_upper)
            if(CMAKE_RUNTIME_OUTPUT_DIRECTORY_${configuration_upper})
                set(directory "${CMAKE_RUNTIME_OUTPUT_DIRECTORY_${configuration_upper}}")
            endif()
        endif()
    else()
        set(directory "${CMAKE_BINARY_DIR}/runtime-resources")
    endif()
    set(${result} "${directory}" PARENT_SCOPE)
endfunction()

function(sky_register_module_resources)
    cmake_parse_arguments(RESOURCE "" "CONFIG" "" ${ARGN})
    if (RESOURCE_UNPARSED_ARGUMENTS OR NOT EXISTS "${RESOURCE_CONFIG}")
        message(FATAL_ERROR "sky_register_module_resources requires an existing CONFIG")
    endif ()
    file(READ "${RESOURCE_CONFIG}" description)
    string(JSON resource_type ERROR_VARIABLE error TYPE "${description}" resources)
    if (error)
        return()
    endif ()
    string(JSON owner ERROR_VARIABLE error GET "${description}" resources owner)
    if (error OR NOT resource_type STREQUAL "OBJECT")
        message(FATAL_ERROR "Invalid resource description: ${RESOURCE_CONFIG}")
    endif ()
    if (NOT owner MATCHES "^[A-Za-z_][A-Za-z_0-9-]*$")
        message(FATAL_ERROR "Invalid module resource owner: ${owner}")
    endif ()
    string(TOLOWER "${owner}" owner_key)
    get_property(owners GLOBAL PROPERTY SKY_MODULE_RESOURCE_OWNERS)
    if (owner_key IN_LIST owners)
        message(FATAL_ERROR "Duplicate module resource owner: ${owner}")
    endif ()
    set_property(GLOBAL APPEND PROPERTY SKY_MODULE_RESOURCE_OWNERS "${owner_key}")
    set_property(GLOBAL APPEND PROPERTY SKY_MODULE_RESOURCE_CONFIGS "${RESOURCE_CONFIG}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${RESOURCE_CONFIG}")

    find_package(Python3 COMPONENTS Interpreter REQUIRED)
    set(exporter "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../python/shader_headers.py")
    if (NOT TARGET ShaderHeaders.Check)
        add_custom_target(ShaderHeaders.Check ALL)
        add_custom_target(ShaderHeaders.Update)
    endif ()
    # Tracked source assets must never become CMake clean's generated byproducts.
    add_custom_target(ShaderHeaders.${owner}.Check
        COMMAND "${Python3_EXECUTABLE}" "${exporter}" --config "${RESOURCE_CONFIG}" --check VERBATIM)
    add_custom_target(ShaderHeaders.${owner}.Update
        COMMAND "${Python3_EXECUTABLE}" "${exporter}" --config "${RESOURCE_CONFIG}" --update VERBATIM)
    add_dependencies(ShaderHeaders.Check ShaderHeaders.${owner}.Check)
    add_dependencies(ShaderHeaders.Update ShaderHeaders.${owner}.Update)
endfunction()

function(sky_stage_shader_resources)
    cmake_parse_arguments(STAGE "" "TARGET;DESTINATION;PROJECT;ENGINE" "CONFIGS;CONSUMERS" ${ARGN})
    find_package(Python3 COMPONENTS Interpreter REQUIRED)
    set(arguments "")
    foreach(config IN LISTS STAGE_CONFIGS)
        list(APPEND arguments --config "${config}")
    endforeach()
    if(STAGE_PROJECT)
        add_custom_target(${STAGE_TARGET} ALL
            COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../python/package_project.py"
                stage-shaders --project "${STAGE_PROJECT}" --engine "${STAGE_ENGINE}" --destination "${STAGE_DESTINATION}" VERBATIM)
    else()
        add_custom_target(${STAGE_TARGET} ALL
            COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../python/module_resources.py"
                ${arguments} --stage "${STAGE_DESTINATION}" VERBATIM)
    endif()
    foreach(consumer IN LISTS STAGE_CONSUMERS)
        if(TARGET ${consumer})
            add_dependencies(${consumer} ${STAGE_TARGET})
        endif()
    endforeach()
endfunction()
