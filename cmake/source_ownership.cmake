include_guard(GLOBAL)

function(_sky_source_path out path base)
    get_filename_component(path "${path}" ABSOLUTE BASE_DIR "${base}")
    if (EXISTS "${path}")
        get_filename_component(path "${path}" REALPATH)
    endif ()
    file(TO_CMAKE_PATH "${path}" path)
    if (CMAKE_HOST_WIN32)
        string(TOLOWER "${path}" path)
    endif ()
    set(${out} "${path}" PARENT_SCOPE)
endfunction()

function(_sky_source_inside out path root)
    file(RELATIVE_PATH relative "${root}" "${path}")
    if (IS_ABSOLUTE "${relative}" OR relative MATCHES "^\\.\\.(/|$)")
        set(${out} FALSE PARENT_SCOPE)
    else ()
        set(${out} TRUE PARENT_SCOPE)
    endif ()
endfunction()

function(_sky_source_targets out out_directories directory)
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    set(directories "${directory}")
    foreach (child IN LISTS children)
        _sky_source_targets(child_targets child_directories "${child}")
        list(APPEND targets ${child_targets})
        list(APPEND directories ${child_directories})
    endforeach ()
    set(${out} "${targets}" PARENT_SCOPE)
    set(${out_directories} "${directories}" PARENT_SCOPE)
endfunction()

# Only a test requiring a different compiled contract may recompile an owner's source.
function(sky_source_compile_variant)
    cmake_parse_arguments(V "" "TARGET;OWNER;SOURCE;REASON" "DEFINITIONS" ${ARGN})
    if (V_UNPARSED_ARGUMENTS OR NOT V_TARGET OR NOT V_OWNER OR NOT V_SOURCE OR
        NOT V_REASON OR NOT V_DEFINITIONS OR V_TARGET STREQUAL V_OWNER)
        message(FATAL_ERROR "Source ownership: variant requires TARGET, OWNER, SOURCE, REASON and DEFINITIONS")
    endif ()
    if (NOT TARGET "${V_TARGET}" OR NOT TARGET "${V_OWNER}")
        message(FATAL_ERROR "Source ownership: variant target and owner must exist")
    endif ()
    get_target_property(is_test "${V_TARGET}" SKY_TEST_TARGET)
    if (NOT is_test)
        message(FATAL_ERROR "Source ownership: compile variants are restricted to test targets")
    endif ()
    _sky_source_path(source "${V_SOURCE}" "${CMAKE_CURRENT_SOURCE_DIR}")
    string(SHA256 key "${source}")
    get_property(registered TARGET "${V_TARGET}" PROPERTY "SKY_SOURCE_VARIANT_${key}" SET)
    if (registered)
        message(FATAL_ERROR "Source ownership: duplicate variant declaration for ${V_TARGET}: ${source}")
    endif ()
    set_property(TARGET "${V_TARGET}" PROPERTY "SKY_SOURCE_VARIANT_${key}" "${V_OWNER}")
    set_property(TARGET "${V_TARGET}" PROPERTY "SKY_SOURCE_VARIANT_${key}_DEFINITIONS" "${V_DEFINITIONS}")
    set_property(TARGET "${V_TARGET}" APPEND PROPERTY SKY_SOURCE_VARIANTS "${key}")
endfunction()

function(sky_validate_source_ownership)
    _sky_source_targets(targets directories "${CMAKE_CURRENT_SOURCE_DIR}")
    _sky_source_path(root "${CMAKE_CURRENT_SOURCE_DIR}" "${CMAKE_CURRENT_SOURCE_DIR}")
    _sky_source_path(build_root "${CMAKE_CURRENT_BINARY_DIR}" "${CMAKE_CURRENT_BINARY_DIR}")
    if (ENGINE_ROOT)
        _sky_source_path(engine_root "${ENGINE_ROOT}" "${CMAKE_CURRENT_SOURCE_DIR}")
    else ()
        set(engine_root "${root}")
    endif ()
    set(keys "")
    foreach (target IN LISTS targets)
        get_target_property(type "${target}" TYPE)
        if (type STREQUAL "UTILITY")
            continue()
        endif ()
        get_target_property(directory "${target}" SOURCE_DIR)
        set(source_directory "${directory}")
        _sky_source_path(directory "${directory}" "${CMAKE_CURRENT_SOURCE_DIR}")
        get_target_property(is_test "${target}" SKY_TEST_TARGET)
        get_target_property(sources "${target}" SOURCES)
        get_target_property(interface_sources "${target}" INTERFACE_SOURCES)
        if (interface_sources)
            foreach (source IN LISTS interface_sources)
                string(TOLOWER "${source}" interface_source)
                get_filename_component(interface_path "${source}" ABSOLUTE BASE_DIR "${source_directory}")
                get_source_file_property(interface_language "${interface_path}" TARGET_DIRECTORY "${target}" LANGUAGE)
                if (source MATCHES "\\$<" OR interface_source MATCHES "\\.(c|cc|cpp|cxx|c\\+\\+|m|mm|ixx)$" OR
                    interface_language MATCHES "^(C|CXX|OBJC|OBJCXX|CUDA|ASM)$")
                    message(SEND_ERROR "Source ownership: ${target} exports a translation unit through INTERFACE_SOURCES: ${source}. Link an implementation target instead.")
                endif ()
            endforeach ()
        endif ()
        if (NOT sources)
            continue()
        endif ()
        foreach (source IN LISTS sources)
            if (source MATCHES "^\\$<TARGET_OBJECTS:[^>]+>$")
                continue()
            elseif (source MATCHES "\\$<")
                message(SEND_ERROR "Source ownership: unresolved source expression in ${target}: ${source}. Select source files with configure-time conditions; reuse object targets with TARGET_OBJECTS.")
                continue()
            endif ()
            string(REGEX MATCH "\\.[^./]+$" extension "${source}")
            string(TOLOWER "${extension}" extension)
            get_filename_component(source "${source}" ABSOLUTE BASE_DIR "${source_directory}")
            get_source_file_property(language "${source}" TARGET_DIRECTORY "${target}" LANGUAGE)
            if (NOT extension MATCHES "^\\.(c|cc|cpp|cxx|c\\+\\+|m|mm|ixx)$" AND
                NOT language MATCHES "^(C|CXX|OBJC|OBJCXX|CUDA|ASM)$")
                continue()
            endif ()
            get_source_file_property(header_only "${source}" TARGET_DIRECTORY "${target}" HEADER_FILE_ONLY)
            if (header_only)
                continue()
            endif ()
            get_source_file_property(generated "${source}" TARGET_DIRECTORY "${target}" GENERATED)
            set(property_path "${source}")
            _sky_source_path(source "${source}" "${directory}")
            string(SHA256 key "${source}")
            set(path_${key} "${source}")
            list(APPEND keys "${key}")
            list(APPEND owners_${key} "${target}")
            get_target_property(variant "${target}" "SKY_SOURCE_VARIANT_${key}")
            _sky_source_inside(local "${source}" "${directory}")
            _sky_source_inside(in_binary "${source}" "${build_root}")
            # Before CMP0163, GENERATED queries only see the declaring directory.
            if (in_binary AND NOT generated)
                foreach (property_directory IN LISTS directories)
                    get_source_file_property(generated "${property_path}" DIRECTORY "${property_directory}" GENERATED)
                    if (generated)
                        break()
                    endif ()
                endforeach ()
            endif ()
            set(fixture FALSE)
            _sky_source_inside(in_engine "${source}" "${engine_root}")
            if (in_engine)
                file(RELATIVE_PATH relative "${engine_root}" "${source}")
            else ()
                file(RELATIVE_PATH relative "${root}" "${source}")
            endif ()
            if (NOT relative MATCHES "^\\.\\./" AND relative MATCHES "(^|/)([^/]+_)?tests?/")
                set(fixture TRUE)
            endif ()
            set(fixture_${key} "${fixture}")
            if (is_test AND NOT fixture AND NOT variant AND NOT (generated AND in_binary))
                message(SEND_ERROR "Source ownership: test ${target} compiles production source ${source}. Link its implementation target instead.")
            elseif (NOT local AND NOT fixture AND NOT variant AND NOT (generated AND in_binary))
                message(SEND_ERROR "Source ownership: ${target} compiles source outside its directory: ${source}. Declare the implementation target in the owning directory and link it.")
            endif ()
        endforeach ()
    endforeach ()

    # Validate exact variant sources and flags; stale declarations must not become exemptions.
    foreach (target IN LISTS targets)
        get_target_property(variants "${target}" SKY_SOURCE_VARIANTS)
        if (NOT variants)
            continue()
        endif ()
        get_target_property(definitions "${target}" COMPILE_DEFINITIONS)
        foreach (key IN LISTS variants)
            get_target_property(owner "${target}" "SKY_SOURCE_VARIANT_${key}")
            if (NOT target IN_LIST owners_${key} OR NOT owner IN_LIST owners_${key})
                message(SEND_ERROR "Source ownership: variant ${target} and owner ${owner} must both compile the declared source")
            endif ()
            get_target_property(required "${target}" "SKY_SOURCE_VARIANT_${key}_DEFINITIONS")
            get_target_property(owner_definitions "${owner}" COMPILE_DEFINITIONS)
            foreach (definition IN LISTS required)
                if (NOT definition IN_LIST definitions OR definition IN_LIST owner_definitions)
                    message(SEND_ERROR "Source ownership: variant ${target} requires distinct compile definition ${definition} from ${owner}")
                endif ()
            endforeach ()
        endforeach ()
    endforeach ()

    list(REMOVE_DUPLICATES keys)
    set(report "")
    foreach (key IN LISTS keys)
        set(owners "${owners_${key}}")
        list(REMOVE_DUPLICATES owners)
        string(APPEND report "${path_${key}} | ${owners}\n")
        if (fixture_${key})
            continue()
        endif ()
        set(primary "")
        foreach (owner IN LISTS owners)
            get_target_property(variant "${owner}" "SKY_SOURCE_VARIANT_${key}")
            if (NOT variant)
                list(APPEND primary "${owner}")
            endif ()
        endforeach ()
        list(LENGTH primary count)
        if (count GREATER 1)
            message(SEND_ERROR "Source ownership: production source ${path_${key}} is compiled by multiple targets: ${primary}. Compile it in one STATIC/OBJECT implementation target and link that target.")
        elseif (count EQUAL 0)
            message(SEND_ERROR "Source ownership: production source ${path_${key}} has no primary compilation owner; variants cannot own each other.")
        endif ()
    endforeach ()
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/source-ownership.txt" "${report}")
endfunction()

# Enqueue validation after deferred source additions, including independent game projects.
function(_sky_schedule_source_validation)
    cmake_language(DEFER CALL sky_validate_source_ownership)
endfunction()
cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL _sky_schedule_source_validation)
