diff --git a/CMakeLists.txt b/CMakeLists.txt
index 6cb480038..b4c2e410b 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -66,6 +66,13 @@ endif()
 #
 enable_language(C CXX)
 
+# Treat source files as UTF-8 so MSVC does not emit C4819 (and turn it into a
+# hard error via C2220 under /WX) when building on a non-UTF-8 system code page
+# (e.g., GBK/936 on Chinese Windows).
+if(MSVC)
+    add_compile_options($<$<COMPILE_LANGUAGE:C,CXX>:/utf-8>)
+endif()
+
 include(FindPackageHandleStandardArgs)
 include(CMakeDependentOption)
 include(GNUInstallDirs)
@@ -657,7 +664,19 @@ if(${SLANG_USE_SYSTEM_GLSLANG})
 endif()
 
 if(SLANG_ENABLE_DXIL)
-    include(FetchDXC)
+    # Reuse the engine's dxcompiler package (3RD_PATH) instead of downloading.
+    set(_sky_dxc_bin "${3RD_PATH}/dxcompiler/bin")
+    foreach(_dll dxcompiler dxil)
+        set(_dst "${CMAKE_BINARY_DIR}/$<CONFIG>/bin/${_dll}.dll")
+        add_custom_command(
+            OUTPUT "${_dst}"
+            COMMAND ${CMAKE_COMMAND} -E copy_if_different "${_sky_dxc_bin}/${_dll}.dll" "${_dst}"
+            DEPENDS "${_sky_dxc_bin}/${_dll}.dll"
+            VERBATIM
+        )
+        add_custom_target(copy-${_dll} DEPENDS "${_dst}")
+        set_target_properties(copy-${_dll} PROPERTIES FOLDER generated)
+    endforeach()
 endif()
 
 add_subdirectory(external)
diff --git a/cmake/SlangTarget.cmake b/cmake/SlangTarget.cmake
index 6a2e9a85d..705a97f5c 100644
--- a/cmake/SlangTarget.cmake
+++ b/cmake/SlangTarget.cmake
@@ -137,6 +137,13 @@ function(slang_add_target dir type)
     # Find the source for this target
     #
     if(ARG_NO_SOURCE)
+        if(CMAKE_GENERATOR STREQUAL "Xcode")
+            # Xcode omits the link step for a library with no compiled sources.
+            set(xcode_link_source "${CMAKE_CURRENT_BINARY_DIR}/${target}-xcode-link.cpp")
+            file(GENERATE OUTPUT "${xcode_link_source}" CONTENT "// Xcode library link anchor.
+")
+            list(APPEND source "${xcode_link_source}")
+        endif()
     elseif(ARG_EXPLICIT_SOURCE)
         list(APPEND source ${ARG_EXPLICIT_SOURCE})
     else()
